# Postgres connection string (Neon, Supabase, or local Docker)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Public site URL (used in share strings, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST credentials (rate limiting on /guess, step 14).
# Names match what the Vercel-managed Upstash resource injects — `vercel env pull`
# fills these in. The limiter fails open, so the game still runs without them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
