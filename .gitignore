# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# agent skills installed by Vercel Marketplace integrations (Neon, Upstash)
/.agents/
/.claude/skills/
/skills-lock.json

# downloaded source data (re-fetch from OurAirports, see README)
/data/airports.csv

# typescript
*.tsbuildinfo
next-env.d.ts
